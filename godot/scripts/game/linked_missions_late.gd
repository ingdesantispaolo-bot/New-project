static func _base(subject: String, topic: String, prompt: String, explanation: String, step: String, output: String, teaching: String) -> Dictionary:
	return {"subject": subject, "topic": topic, "prompt": prompt, "explanation": explanation, "missionStep": step, "missionOutput": output, "missionTeaching": teaching}

static func _num(subject: String, topic: String, prompt: String, answer: int, explanation: String, step: String, output: String, teaching: String) -> Dictionary:
	var node := _base(subject, topic, prompt, explanation, step, output, teaching)
	node.merge({"format": "numeric_input", "answer": str(answer)})
	return node

static func _mc(subject: String, topic: String, prompt: String, options: Array, answer: String, explanation: String, step: String, output: String, teaching: String) -> Dictionary:
	var node := _base(subject, topic, prompt, explanation, step, output, teaching)
	node.merge({"format": "multiple_choice", "options": options, "answer": answer})
	return node

static func _order(subject: String, topic: String, prompt: String, items: Array, correct: Array, explanation: String, step: String, output: String, teaching: String) -> Dictionary:
	var node := _base(subject, topic, prompt, explanation, step, output, teaching)
	node.merge({"format": "ordering", "items": items, "correctOrder": correct})
	return node

static func _matching(subject: String, topic: String, prompt: String, pairs: Array, explanation: String, step: String, output: String, teaching: String) -> Dictionary:
	var node := _base(subject, topic, prompt, explanation, step, output, teaching)
	node.merge({"format": "matching", "pairs": pairs})
	return node
