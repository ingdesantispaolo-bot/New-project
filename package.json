{
  "name": "eli-quest-accademia-missioni",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs --configLoader native --host 127.0.0.1",
    "dev:lan": "vite --config vite.config.mjs --configLoader native --host 0.0.0.0",
    "build": "node scripts/audit-web-release.mjs && vite build --config vite.config.mjs --configLoader native",
    "release:web": "npm run version:stamp && npm run export:web && npm run web:sync && npm run build",
    "export:web": "node scripts/export-godot-web.mjs",
    "banks:build": "node scripts/build-exercise-banks.mjs",
    "assets:reward": "node scripts/build-reward-assets.mjs",
    "assets:exercise-atlas": "node scripts/build-exercise-atlas.mjs",
	"assets:identity:compact": "node scripts/compact-identity-atlases.mjs",
    "terrain:noise": "node scripts/build-terrain-noise-texture.mjs",
    "terrain:noise:check": "node scripts/build-terrain-noise-texture.mjs --check",
    "audio:godot": "node scripts/build-godot-audio-assets.mjs",
    "audio:godot:audit": "node scripts/build-godot-audio-assets.mjs --check",
    "audit:web": "node scripts/audit-web-release.mjs",
    "web:sync": "node scripts/sync-web-build.mjs",
    "web:sync:check": "node scripts/sync-web-build.mjs --check",
    "smoke:web:godot": "node scripts/smoke-godot-web.mjs public/godot/outdoor artifacts/web-smoke-current",
    "profile:web:godot": "node scripts/smoke-godot-web.mjs public/godot/outdoor artifacts/web-profile-current --school-profile",
    "preview": "vite preview --config vite.config.mjs --configLoader native --host 127.0.0.1",
    "preview:lan": "vite preview --config vite.config.mjs --configLoader native --host 0.0.0.0",
    "audit:godot": "node scripts/run-godot-audits.mjs",
    "version:stamp": "node scripts/stamp-version.mjs"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "vite": "^6.3.5"
  }
}
