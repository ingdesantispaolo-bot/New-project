{
  // Configurazione del Worker. Deve restare l'UNICO file di configurazione in
  // questa cartella: con un `wrangler.toml` accanto, wrangler si rifiuta di
  // partire perché non sa quale dei due leggere.

  "name": "eli-quest-save",
  "main": "index.ts",
  "compatibility_date": "2026-08-06",

  // Il ponte fra il pannello e il codice.
  //
  //   "binding" -> come lo vede il codice: `env.SAVES`
  //   "id"      -> quale spazio KV è, preso dal pannello
  //
  // Sono due nomi diversi di proposito. Nel pannello lo spazio si chiama
  // `Eli_game`; qui dentro lo chiamiamo `SAVES`. Cambiare `binding` significa
  // cambiare anche `env.SAVES` in `index.ts`.
  //
  // L'ID si copia dal pannello: Storage & Databases -> KV -> accanto a
  // `Eli_game`. È una stringa lunga di lettere e numeri.
  "kv_namespaces": [
    {
      "binding": "SAVES",
      "id": "INCOLLA_QUI_IL_NAMESPACE_ID_DI_Eli_game"
    }
  ]
}
